# API
PORT=3001
OIDC_PORT=3002
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Leave DATABASE_URL empty to use the embedded development database.
# DATABASE_URL=postgres://abapro:abapro@localhost:5432/abapro
PGLITE_DIR=apps/api/data/pglite
COOKIE_SECRET=dev-only-cookie-secret-change-me!!
EMBEDDED_OIDC=true
# Production uses an external issuer instead of EMBEDDED_OIDC.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://app.example.com/api/v1/auth/callback
# OIDC_PASSWORD_RESET_URL=https://id.example.com/reset

# Web. Leave this relative so the session cookie stays on the application origin.
VITE_API_BASE_URL=/api/v1
